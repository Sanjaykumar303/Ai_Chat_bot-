# Copy this file to ".env" and paste your own key.
# Get a free key from https://aistudio.google.com/apikey

GEMINI_API_KEY=your_key_here

# Optional. Change only if you want a different Gemini model.
GEMINI_MODEL=gemini-flash-latest

# Optional. Comma-separated origin(s) of the deployed frontend (e.g. your
# Vercel domain: https://your-app.vercel.app), allowed through CORS in
# addition to localhost. Not needed for local dev. No spaces, no trailing
# slash. See main.py's CORS setup.
# FRONTEND_ORIGIN=https://your-app.vercel.app

# Optional. Set to "true" to log each stage of the voice pipeline (raw
# transcript, detected language, normalized query, intent, retrieved chunk
# distances, final answer) to the backend console. Leave "false" in normal
# use - this is a development aid, not something end users should see.
DEBUG_VOICE_PIPELINE=false

# --- Database Q&A (services/db_client.py) ---
#
# Connect either ONE single URL...
# SUPABASE_DB_URL=postgresql://readonly_chat_role:PASSWORD@HOST:5432/postgres?sslmode=require
#
# ...OR the discrete PG* vars below (standard libpq names) - used only if
# SUPABASE_DB_URL isn't set. Use a dedicated READ-ONLY Postgres role here,
# not the default "postgres" superuser - see the project plan for the
# exact CREATE ROLE SQL to run in the Supabase SQL editor first.
# PGHOST=your-project.pooler.supabase.com
# PGPORT=5432
# PGUSER=readonly_chat_role.your-project-ref
# PGPASSWORD=your_readonly_role_password
# PGDATABASE=postgres
# PGSSLMODE=require

# Optional. Postgres schema to read tables from.
DB_SCHEMA_NAME=public

# Optional but strongly recommended on any database you haven't fully
# reviewed. Comma-separated table names - only these are exposed to the
# Gemini SQL-generation prompt, the sql_guard table allowlist, and the
# intent-router's database-question vocabulary. Left unset, every table
# in DB_SCHEMA_NAME is exposed, which is rarely what you want on a
# database with tables you haven't vetted yet (credentials, health data,
# PII, etc.). No spaces around the commas.
# DB_QUERY_ALLOWED_TABLES=orders,customers,products

# Optional. Every generated SQL query is capped to this many rows,
# regardless of what Gemini writes (services/sql_guard.py enforces this).
DB_QUERY_ROW_LIMIT=100

# Optional. Server-side statement timeout (ms) applied to every database
# query, so a slow/expensive generated query can't hang or run up cost.
DB_QUERY_TIMEOUT_MS=5000

# Optional. How long the introspected table/column schema is cached
# before being re-read - the schema can change outside this app (Supabase
# Studio, migrations), unlike the FAISS index which only changes via /upload.
DB_SCHEMA_CACHE_TTL=600
